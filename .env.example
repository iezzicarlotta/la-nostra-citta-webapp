NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change-me
